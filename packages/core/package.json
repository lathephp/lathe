{
  "name": "@lathephp/core",
  "version": "1.0.0-beta.4",
  "description": "The browser API of the Lathe admin panel for plugins.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lathephp/lathe.git",
    "directory": "packages/core"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing.js"
    },
    "./tokens.css": "./tokens.css"
  },
  "files": [
    "dist",
    "tokens.css",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build && vite build --mode testing && tsc -b"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.3"
  }
}
