{
  "name": "@lathephp/core",
  "version": "1.0.0-dev",
  "description": "The browser API of the Lathe admin panel for plugins.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "!dist/*.tsbuildinfo"
  ],
  "scripts": {
    "build": "vite build && vite build --mode testing && tsc -b"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  },
  "peerDependencies": {
    "react": "19.3.0"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.3"
  }
}
