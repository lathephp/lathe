[Unit]
Description=The Lathe demo's queue worker
After=lathe-demo-mysql.service
Requires=lathe-demo-mysql.service

[Service]
User=www-data
Group=www-data
WorkingDirectory=/srv/lathe-demo
ExecStart=/usr/bin/php artisan queue:work --tries=1 --max-time=3600
Restart=always

[Install]
WantedBy=multi-user.target
