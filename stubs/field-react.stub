import { field } from '@lathephp/core';
import type { FieldProps } from '@lathephp/core';

function {{ class }}({ field: definition, value, onChange, id, describedBy, invalid, disabled }: FieldProps) {
  return (
    <input
      id={id}
      type="text"
      value={typeof value === 'string' ? value : ''}
      onChange={(event) => {
        onChange(event.target.value);
      }}
      placeholder={definition.placeholder ?? undefined}
      aria-describedby={describedBy}
      aria-invalid={invalid || undefined}
      disabled={disabled}
      className="flex h-9 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm"
    />
  );
}

field('{{ component }}', {{ class }});
