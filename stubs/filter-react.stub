import { filter } from '@lathephp/core';
import type { FilterProps } from '@lathephp/core';
import { Button, Input } from '@lathephp/ui';
import { Field, FieldLabel } from '@lathephp/ui/field';
import { useId } from 'react';

function {{ class }}({ filter: definition, value, onChange }: FilterProps) {
  const id = useId();
  const text = typeof value === 'string' ? value : '';

  return (
    <Field>
      <FieldLabel htmlFor={id}>{definition.name}</FieldLabel>
      <Input
        id={id}
        type="text"
        value={text}
        onChange={(event) => {
          onChange(event.target.value);
        }}
      />
      <Button
        type="button"
        variant="ghost"
        size="sm"
        disabled={text === ''}
        onClick={() => {
          onChange(null);
        }}
      >
        Clear
      </Button>
    </Field>
  );
}

filter('{{ component }}', {{ class }});
