import { filter } from '@lathephp/core';
import { Input } from '@lathephp/ui';
import { Field, FieldLabel } from '@lathephp/ui/field';
import { useId } from 'react';

interface {{ class }}Props {
  filter: { name: string };
  value: unknown;
  onChange: (value: unknown) => void;
}

function {{ class }}({ filter: definition, value, onChange }: {{ class }}Props) {
  const id = useId();

  return (
    <Field>
      <FieldLabel htmlFor={id}>{definition.name}</FieldLabel>
      <Input
        id={id}
        type="text"
        value={typeof value === 'string' ? value : ''}
        onChange={(event) => {
          onChange(event.target.value);
        }}
      />
    </Field>
  );
}

filter('{{ component }}', {{ class }});
