import { resourcePlugin } from '@lathephp/core';
import type { ResourcePluginProps } from '@lathephp/core';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@lathephp/ui';

function {{ class }}({ resourceName, resourceId }: ResourcePluginProps) {
  return (
    <Card>
      <CardHeader>
        <CardTitle>{{ name }}</CardTitle>
        <CardDescription>{`${resourceName} #${resourceId}`}</CardDescription>
      </CardHeader>
      <CardContent>{/* Your resource plugin content */}</CardContent>
    </Card>
  );
}

resourcePlugin('{{ component }}', {{ class }});
