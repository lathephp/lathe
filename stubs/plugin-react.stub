import { plugin } from '@lathephp/core';
import { Card, CardContent, CardHeader, CardTitle } from '@lathephp/ui';

function {{ class }}() {
  return (
    <Card>
      <CardHeader>
        <CardTitle>{{ name }}</CardTitle>
      </CardHeader>
      <CardContent>{/* Your plugin page content */}</CardContent>
    </Card>
  );
}

plugin('{{ component }}', {{ class }});
