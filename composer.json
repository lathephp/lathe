{
    "name": "lathe/lathe",
    "description": "An admin panel for Laravel, built with React and Inertia.",
    "keywords": [
        "laravel",
        "admin",
        "panel",
        "inertia",
        "react"
    ],
    "homepage": "https://lathephp.com",
    "license": "MIT",
    "type": "library",
    "repositories": [
        {
            "type": "path",
            "url": "workbench/lathe-components/*"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-intl": "*",
        "inertiajs/inertia-laravel": "^3.5.1",
        "laravel/fortify": "^1.41",
        "laravel/framework": "^13.32",
        "league/commonmark": "^2.10.3",
        "symfony/html-sanitizer": "^8.1"
    },
    "require-dev": {
        "acme/heartbeat": "@dev",
        "larastan/larastan": "^3.13",
        "laravel/octane": "^2.20",
        "laravel/pint": "^1.25",
        "laravel/scout": "^11.8",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-browser": "^5.1",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Lathe\\": "src/",
            "Lathe\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Lathe\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lathe\\LatheServiceProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "trap 'kill $(jobs -p) 2>/dev/null' EXIT; php vendor/bin/testbench queue:work --tries=1 --ansi & php vendor/bin/testbench serve --ansi"
        ],
        "lint": [
            "pint --test",
            "bash scripts/check-patterns.sh",
            "bash scripts/pnpm.sh translations"
        ],
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G",
        "test": [
            "@php vendor/bin/pest --parallel --exclude-group=browser --exclude-group=benchmark --exclude-group=budget --exclude-group=scaffold",
            "bash scripts/pnpm.sh -r test"
        ],
        "qa": [
            "@lint",
            "@analyse",
            "@types",
            "@test"
        ],
        "test:scaffold": "@php vendor/bin/pest --group=scaffold",
        "test:budget": "@php vendor/bin/pest --group=budget",
        "test:bench": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/bench-lanes.sh"
        ],
        "test:octane": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/octane-lane.sh"
        ],
        "test:matrix": [
            "Composer\\Config::disableProcessTimeout",
            "bash scripts/matrix.sh"
        ],
        "test:browser": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/pest tests/Browser"
        ],
        "types": "@php -d memory_limit=2G vendor/bin/pest --type-coverage --min=100",
        "mutate": [
            "@php -d pcov.enabled=1 -d memory_limit=2G vendor/bin/pest --mutate --parallel --passthru-php='-d pcov.enabled=1' --covered-only --class=Lathe\\\\Query --min=80",
            "@php -d pcov.enabled=1 -d memory_limit=2G vendor/bin/pest --mutate --parallel --passthru-php='-d pcov.enabled=1' --covered-only --class=Lathe\\\\Auth --min=80",
            "@php -d pcov.enabled=1 -d memory_limit=2G vendor/bin/pest --mutate --parallel --passthru-php='-d pcov.enabled=1' --covered-only --class=Lathe\\\\Field --min=80"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
