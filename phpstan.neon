includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 10
    # Inside the checkout, so a worktree's cache goes with it instead of filling /tmp.
    tmpDir: .phpstan-cache
    paths:
        - src
        - workbench/app
        - config
        - database
    reportUnmatchedIgnoredErrors: true
    configDirectories:
        - config
        - database
