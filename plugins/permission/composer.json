{
    "name": "lathe/permission",
    "description": "Roles and permissions for Lathe, built on spatie/laravel-permission.",
    "keywords": [
        "laravel",
        "lathe",
        "spatie",
        "permission",
        "roles"
    ],
    "homepage": "https://lathephp.com",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.4",
        "lathe/lathe": "^1.0",
        "spatie/laravel-permission": "^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "Lathe\\Permission\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lathe\\Permission\\PermissionServiceProvider"
            ]
        },
        "lathe": {
            "plugin": "Lathe\\Permission\\PermissionPlugin"
        }
    },
    "minimum-stability": "stable"
}
