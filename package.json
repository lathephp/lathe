{
  "name": "lathe",
  "version": "1.0.0-dev",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm --filter \"./packages/*\" build && vite build",
    "types": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run --coverage",
    "translations": "node scripts/check-translations.mjs",
    "size": "node scripts/size.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "chart-slots": "node scripts/check-chart-slots.mjs",
    "logical-css": "bash scripts/check-logical-css.sh",
    "bench:browser": "node scripts/bench-browser.mjs",
    "ui:add": "pnpm dlx shadcn@4.21.0 add"
  },
  "dependencies": {
    "@inertiajs/react": "3.9.1",
    "@lathephp/core": "workspace:*",
    "@lathephp/ui": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@eslint/js": "9.39.5",
    "@rolldown/plugin-babel": "0.2.4",
    "@tailwindcss/typography": "0.5.20",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/babel__core": "7.20.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.4",
    "web-vitals": "6.2.2"
  }
}
